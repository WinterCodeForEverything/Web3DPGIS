# Copy to .env and adjust; load with: set -a; source .env; set +a
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://3d.example.com when served behind HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=southcloud
POSTGRES_USER=southcloud
POSTGRES_PASSWORD=southcloud
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# File storage: "local" (the media/ folder) or "s3" (an S3-compatible bucket shared by all servers and workers).
# With s3, run `python manage.py setup_storage` once, and `copy_media_to_storage` to move existing local files.
STORAGE_BACKEND=local
# S3_BUCKET=3dpgis
# S3_ENDPOINT_URL=http://127.0.0.1:8333      # leave empty for AWS; the provider's endpoint for OSS, COS, R2, SeaweedFS …
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ADDRESSING_STYLE=path                   # "virtual" for AWS / Aliyun OSS / Tencent COS
# S3_PUBLIC_DOMAIN=127.0.0.1:8333/3dpgis     # host (+ path) browsers read the bucket from, e.g. a CDN domain
# S3_PUBLIC_PROTOCOL=http:                   # https: in production
# STORAGE_CORS_ORIGINS=https://3d.example.com   # the app's origin(s), allowed to fetch tiles from the bucket
# PIPELINE_WORK_DIR=                         # local scratch space for jobs; the system temp folder when empty

# Background processing: Celery with a Redis-compatible broker (Valkey locally)
CELERY_BROKER_URL=redis://localhost:6379/0
# true runs jobs inside the web request instead of a worker (handy for quick experiments, not for production)
CELERY_TASK_ALWAYS_EAGER=false

# Where models without their own georeference are placed: longitude,latitude,height
DEFAULT_MODEL_LOCATION=113.26,23.13,0
# Largest accepted upload, in bytes (2 GiB)
MAX_UPLOAD_SIZE=2147483648

# 3D reconstruction (reconstruction app); its jobs go to their own queue: celery -A config worker -Q celery,reconstruction
# RECONSTRUCTION_QUEUE=reconstruction
# RECONSTRUCTION_COLMAP=colmap               # COLMAP command, on PATH by default
# RECONSTRUCTION_TOOLS_DIR=                  # folder with openmvs/ (and obj2tiles/); ../recon-tools when empty
RECONSTRUCTION_USE_GPU=false                 # true needs a CUDA build of COLMAP
RECONSTRUCTION_MAX_IMAGE_SIZE=0              # caps the presets' photo size, e.g. 2000 on an 8 GB machine; 0 = no cap
# RECONSTRUCTION_SEAM_LEVELING=              # texture seam levelling; off on macOS by default (broken in OpenMVS 2.4.0 there)
# RECONSTRUCTION_WORK_DIR=                   # S3 storage only: local work folders; the system temp folder when empty
RECONSTRUCTION_MIN_PHOTOS=3
RECONSTRUCTION_MAX_PHOTOS=1000
RECONSTRUCTION_MAX_PHOTO_SIZE=52428800       # bytes per photo (50 MiB)
RECONSTRUCTION_UPLOAD_URL_EXPIRES=3600       # seconds a presigned photo upload URL stays valid (S3 storage)
# RECONSTRUCTION_GEOID_GRID=us_nga_egm96_15.tif
RECONSTRUCTION_GEOID_DOWNLOAD=true           # fetch the geoid grid once from cdn.proj.org

# Archive limits, checked before anything is extracted ("zip bomb" protection)
PIPELINE_MAX_EXTRACTED_SIZE=21474836480     # bytes after unpacking (20 GiB)
PIPELINE_MAX_ARCHIVE_FILES=100000
PIPELINE_MAX_COMPRESSION_RATIO=200          # judged once an archive unpacks to more than 64 MiB
PIPELINE_MIN_FREE_SPACE=1073741824          # bytes the worker always leaves free on disk (1 GiB)

# Temporary failures (converter killed, disk full, database blip) are retried; bad uploads fail at once
PIPELINE_MAX_RETRIES=3
PIPELINE_RETRY_BACKOFF=30                   # seconds before the first retry, doubled for each next one

# Only if GeoDjango cannot find GDAL/GEOS on its own (Homebrew paths are detected automatically)
# GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib

# Front end (read by `npm run build` / `npm run dev` in frontend/, put it in frontend/.env.local):
# VITE_CESIUM_ION_TOKEN=   optional, https://ion.cesium.com/tokens, only for Cesium ion terrain/imagery
