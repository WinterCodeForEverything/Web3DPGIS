# Copy to .env and adjust; load with: set -a; source .env; set +a
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://3d.example.com when served behind HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=southcloud
POSTGRES_USER=southcloud
POSTGRES_PASSWORD=southcloud
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: https://ion.cesium.com/tokens (only needed for Cesium ion terrain/imagery)
CESIUM_ION_TOKEN=
